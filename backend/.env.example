# Database
# For Docker Compose use: postgresql://ascend:ascend@db:5432/ascend
# For local SQLite use: sqlite:///./ascend.db
DB_PATH=postgresql://ascend:ascend@localhost:5432/ascend

# App
DEBUG=true
TIMEZONE=UTC

# Security
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-fernet-key

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON list of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (used by docker-compose)
POSTGRES_USER=ascend
POSTGRES_PASSWORD=ascend
POSTGRES_DB=ascend

# LLM (local Ollama or compatible OpenAI endpoint)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
